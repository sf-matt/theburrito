# Copy this file to .env for local development. Never commit .env.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=2048
KUBECONFIG=/ABSOLUTE/PATH/to/ai-investigator.kubeconfig
WATCH_LABEL_SELECTOR=
DRY_RUN=true
INVESTIGATION_COOLDOWN_SECONDS=300
MAX_TOOL_CALLS=2
AGENT_STATE_FILE=state/assessments.json
STATE_OBSERVATION_FLUSH_SECONDS=60
AGENT_LOG_FILE=
AGENT_LOG_MAX_BYTES=5242880
AGENT_LOG_BACKUP_COUNT=3
